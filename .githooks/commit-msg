#!/usr/bin/env bash
# Reject any commit message carrying AI attribution.
#
# This repo's commits are authored by its owner. A `Co-Authored-By: Claude`
# trailer, a "Generated with Claude Code" line, or a 🤖 byline all have to stay
# out of the history — and because the history is written by an unattended
# agent, "stay out" cannot rest on the agent remembering to leave them out.
#
# `.claude/settings.json` sets `includeCoAuthoredBy: false`, and CLAUDE.md says
# the same thing in prose. This hook is the layer that does not depend on either
# of those being read: git will not create the commit if the message matches.
#
# Installed by `./scripts/install_hooks.sh`, which points core.hooksPath here so
# the hook is version-controlled rather than hiding in .git/hooks.
set -euo pipefail

msg_file="${1:?commit message file}"

# Case-insensitive. Each pattern is a thing that has actually shown up in
# agent-written commit messages.
patterns=(
  'co-authored-by:.*claude'
  'co-authored-by:.*anthropic'
  'co-authored-by:.*noreply@anthropic'
  'generated with .*claude'
  'generated by .*claude'
  '🤖'
  'claude code'
)

found=""
for pattern in "${patterns[@]}"; do
  if grep -qiE "${pattern}" "${msg_file}"; then
    found="${found}  - matched: ${pattern}"$'\n'
  fi
done

if [ -n "${found}" ]; then
  cat >&2 <<EOF
commit-msg: refusing this commit — the message contains AI attribution.

${found}
This repo keeps attribution out of its history. Remove the offending line and
commit again.

If an agent wrote this message, the fix is upstream of here:
  - .claude/settings.json must set "includeCoAuthoredBy": false
  - CLAUDE.md must keep saying no attribution, ever

To see the message that was rejected:
  cat "${msg_file}"
EOF
  exit 1
fi
